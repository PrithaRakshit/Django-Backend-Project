# ──────────────────────────────────────────────────────────────────
# Django core settings
# ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-key-for-dev

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ──────────────────────────────────────────────────────────────────
# Database
# Leave DATABASE_URL empty to use the default SQLite file.
# For PostgreSQL use: postgresql://user:password@localhost:5432/dbname
# ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────────
# HubSpot API settings
# ──────────────────────────────────────────────────────────────────
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TIMEOUT=30

# Rate limiting: 150 requests per 10 seconds (HubSpot default)
HUBSPOT_RATE_LIMIT_REQUESTS=150
HUBSPOT_RATE_LIMIT_PERIOD=10

# ──────────────────────────────────────────────────────────────────
# Pipeline / service settings
# ──────────────────────────────────────────────────────────────────
PIPELINE_NAME=hubspot_deals
DB_SCHEMA=hubspot_deals

# Number of HubSpot pagination pages between checkpoint saves
CHECKPOINT_EVERY=5

# ──────────────────────────────────────────────────────────────────
# Server port (used in Docker / gunicorn)
# ──────────────────────────────────────────────────────────────────
SERVICE_PORT=5200
